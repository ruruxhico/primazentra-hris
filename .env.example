#--------------------------------------------------------------------
# PrimaZentra HRIS (main app) — copy to .env and fill in.
# tools/hris_setup.php does this for all three apps and generates the
# matching API keys; see RUN-GUIDE.md.
#--------------------------------------------------------------------

CI_ENVIRONMENT = development
# Base URL is set in app/Config/App.php: http://localhost/primazentra-hris

# Firebase: the service-account key goes in writable/credentials/firebase_key.json (never committed)
FIREBASE_STORAGE_BUCKET = primazentra-hris.firebasestorage.app

#--------------------------------------------------------------------
# HRIS integration (REST, X-Api-Key per calling app)
#--------------------------------------------------------------------
HRIS_APP_NAME = main
HRIS_MAIN_URL = http://localhost/primazentra-hris/
HRIS_ATTENDANCE_URL = http://localhost/hris-attendance/
HRIS_PAYROLL_URL = http://localhost/hris-payroll/

# Key this app sends when calling Attendance / Payroll
HRIS_ATTENDANCE_API_KEY = <same value as "main:" in hris-attendance HRIS_API_KEYS>
HRIS_PAYROLL_API_KEY = <same value as "main:" in hris-payroll HRIS_API_KEYS>

# Keys this app accepts on /api/v1/* (caller:key,caller:key)
HRIS_API_KEYS = attendance:<attendance's HRIS_MAIN_API_KEY>,payroll:<payroll's HRIS_MAIN_API_KEY>

# Hides PrimaZentra modules that are not part of the HRIS build
HRIS_SHOW_CONSTRUCTION = false

#--------------------------------------------------------------------
# Optional — not needed to run the HRIS integration
#--------------------------------------------------------------------
AUTH_REQUIRE_EMAIL_VERIFICATION = false

# Outgoing mail (welcome / reset emails). Leave blank to skip.
EMAIL_PROTOCOL = smtp
EMAIL_SMTP_HOST = smtp.gmail.com
EMAIL_SMTP_PORT = 587
EMAIL_SMTP_CRYPTO = tls
EMAIL_SMTP_USER =
EMAIL_SMTP_PASS =
EMAIL_FROM =
EMAIL_FROM_NAME = PrimaZentra

# Google Maps (project address picker, outside the HRIS scope). Leave blank to disable.
GOOGLE_MAPS_KEY =
GOOGLE_MAPS_BROWSER_KEY =

# PrimaZentra ML service (outside the HRIS scope)
ml.baseUrl = https://primazentra-ml-production.up.railway.app
ml.timeoutSeconds = 5
